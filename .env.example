# Copie este arquivo como .env (na mesma pasta) e preencha. O .env nunca vai para o GitHub.
# Sem estas duas linhas o CRM usa só o banco local (data\crm.db).
TURSO_DATABASE_URL=libsql://NOME-DO-BANCO-SEU-USUARIO.turso.io
TURSO_AUTH_TOKEN=cole-o-token-aqui

# Acesso pelo celular (Cloudflare Tunnel até este PC): os mesmos valores do Render (Environment).
# TEAM_DOMAIN: SEU-TIME.cloudflareaccess.com. AUD: o "Application Audience (AUD) Tag" do app CRM.
# Vazio = o celular fica bloqueado; no PC (localhost) o CRM funciona normal.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Atualização automática do PC (baixa a versão nova do GitHub e reinicia quando ninguém está usando).
# Ligada por padrão. Para desligar, tire o # da linha abaixo.
# CRM_AUTOATUALIZAR=0

# Assistente (chat com o Claude, tela Assistente). Chave em console.anthropic.com > API Keys (começa com sk-ant-).
# A API cobra por uso, à parte da assinatura do Claude, e precisa de crédito em Billing. Vazio = assistente desligado.
# A chave também pode ser colada em Configurações › Assistente; a deste arquivo tem prioridade.
ANTHROPIC_API_KEY=
# Opcional: outro modelo (padrão claude-haiku-5-5, o mais barato; claude-sonnet-5-5 e claude-opus-5-5 custam mais) e o esforço
# de raciocínio (low, medium, high; padrão medium).
# ASSISTENTE_MODELO=claude-haiku-5-5
# ASSISTENTE_ESFORCO=medium
# Opcional: mandar pelo OmniRoute (ou outro proxy) em vez da API direta. A chave acima vira a chave do proxy.
# ANTHROPIC_BASE_URL=http://localhost:20128
