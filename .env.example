# Copie este arquivo como .env (na mesma pasta) e preencha. O .env nunca vai para o GitHub.
# Sem estas duas linhas o CRM usa só o banco local (data\crm.db).
TURSO_DATABASE_URL=libsql://NOME-DO-BANCO-SEU-USUARIO.turso.io
TURSO_AUTH_TOKEN=cole-o-token-aqui

# Acesso pelo celular (Cloudflare Tunnel até este PC): os mesmos valores do Render (Environment).
# TEAM_DOMAIN: summer-scene-f0e8.cloudflareaccess.com. AUD: o "Application Audience (AUD) Tag" do app CRM.
# Vazio = o celular fica bloqueado; no PC (localhost) o CRM funciona normal.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Atualização automática do PC (baixa a versão nova do GitHub e reinicia quando ninguém está usando).
# Ligada por padrão. Para desligar, tire o # da linha abaixo.
# CRM_AUTOATUALIZAR=0
